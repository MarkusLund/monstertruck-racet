{
  "name": "monstertruck-racet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "3D monstertruck-racing for 1–4 spillere (tastatur, DualSense, flere Mac-er via nettleser)",
  "scripts": {
    "start": "vite --open",
    "host": "vite --open",
    "tunnel": "cloudflared tunnel --metrics 127.0.0.1:20241 --url http://localhost:5173",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "playwright test",
    "cf:dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  }
}
